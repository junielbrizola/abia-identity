ARG KEYCLOAK_VERSION=26.8.2

FROM maven:3.9-eclipse-temurin-25 AS source-build
ARG KEYCLOAK_VERSION
WORKDIR /src
COPY . .
RUN ./mvnw -pl quarkus/deployment,quarkus/dist -am -DskipTests clean install \
    && archive="$(find quarkus/dist/target -maxdepth 1 -type f -name 'keycloak-*.zip' ! -name '*sources*' -print -quit)" \
    && test -n "$archive" \
    && mkdir -p /out \
    && cd /out \
    && jar xf "/src/$archive" \
    && find "/out/keycloak-${KEYCLOAK_VERSION}/bin" -type f -name '*.sh' -exec chmod 755 {} \; \
    && test -f "/out/keycloak-${KEYCLOAK_VERSION}/bin/kc.sh"

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION}
ARG KEYCLOAK_VERSION
COPY --from=source-build --chown=keycloak:keycloak /out/keycloak-${KEYCLOAK_VERSION}/ /opt/keycloak/
COPY --from=source-build --chown=keycloak:keycloak /src/themes/abia/ /opt/keycloak/themes/abia/
